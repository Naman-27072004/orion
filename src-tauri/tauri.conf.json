{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "0.1.0",
  "identifier": "com.orion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orion - ARM64 Laptop Intelligence",
        "width": 1280,
        "height": 800,
        "center": true,
        "maximized": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Orion Intelligence Corp",
    "copyright": "© 2026 Orion Team. All rights reserved.",
    "shortDescription": "Orion ARM64 Laptop Intelligence Platform",
    "longDescription": "Orion is an advanced system intelligence and performance monitoring suite optimized for ARM64 and Windows laptops.",
    "licenseFile": "installer/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "English",
          "German",
          "French",
          "Japanese",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/custom_hooks.nsh"
      }
    }
  }
}
